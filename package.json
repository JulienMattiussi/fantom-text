{
  "name": "fantom-text",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A tiny embeddable, zero-dependency ghost text toy: text hidden in noise, visible only in motion.",
  "author": "YavaDeus",
  "homepage": "https://fantom-text.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/JulienMattiussi/fantom-text.git"
  },
  "bugs": {
    "url": "https://github.com/JulienMattiussi/fantom-text/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "canvas",
    "optical-illusion",
    "persistence-of-vision",
    "widget",
    "embeddable",
    "vanilla"
  ],
  "scripts": {
    "dev": "concurrently -k -n snippet,vite -c magenta,cyan \"npm:build:snippet:watch\" \"vite\"",
    "build": "npm run build:snippet && vue-tsc -b && vite build",
    "preview": "vite preview",
    "build:snippet": "esbuild src/snippet/fantom-text.ts --bundle --outfile=public/fantom-text.js --minify --target=es2019",
    "build:snippet:watch": "esbuild src/snippet/fantom-text.ts --bundle --outfile=public/fantom-text.js --target=es2019 --sourcemap --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "vue-tsc -b --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^9.30.0",
    "gifenc": "^1.0.3",
    "globals": "^15.12.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.15.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^2.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
